{
  "name": "harnessmeter",
  "version": "0.3.0",
  "description": "Local context profiler for coding agents: estimated instruction footprint, session evidence and reviewable demotion proposals. Offline by default.",
  "type": "module",
  "bin": {
    "harnessmeter": "bin/harnessmeter.js"
  },
  "main": "dist/cli.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/harnessmeter.js",
    "test": "node --test \"test/*.test.ts\"",
    "bench:ci": "node bench/run.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "keywords": [
    "claude-code",
    "claude-md",
    "agent-harness",
    "context-engineering",
    "harness-engineering",
    "profiler",
    "llm",
    "mcp",
    "ai-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alebgl77/harnessmeter.git"
  },
  "homepage": "https://github.com/alebgl77/harnessmeter#readme",
  "bugs": {
    "url": "https://github.com/alebgl77/harnessmeter/issues"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
