{
  "name": "harnessmeter",
  "version": "0.1.1",
  "description": "A profiler for your agentic harness. Price every line of CLAUDE.md, every skill, subagent and MCP server — then find the ones that don't earn their place.",
  "type": "module",
  "bin": {
    "harnessmeter": "bin/harnessmeter.js"
  },
  "main": "dist/cli.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/harnessmeter.js",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build"
  },
  "keywords": [
    "claude-code",
    "claude-md",
    "agent-harness",
    "context-engineering",
    "harness-engineering",
    "profiler",
    "llm",
    "mcp",
    "ai-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alebgl77/harnessmeter.git"
  },
  "homepage": "https://github.com/alebgl77/harnessmeter#readme",
  "bugs": {
    "url": "https://github.com/alebgl77/harnessmeter/issues"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
